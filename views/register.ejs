<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>회원가입</title>
</head>
<body>
    <h1>회원가입</h1>

    <form name="reg" action="" method="post">
        <table>
            <tr>
                <td>아이디</td>
                <td><input type="text" name="userid" placeholder="사용할 아이디 입력" required></td>
            </tr>
            <tr>
                <td>암호</td>
                <td><input type="password" name="passwd" placeholder="사용할 암호 입력" required></td>
            </tr>
            <tr>
                <td>이름</td>
                <td><input type="text" name="name" placeholder="이름 입력" required></td>
            </tr>
            <tr>
                <td>email</td>
                <td><input type="text" name="email" placeholder="email주소 입력" required></td>
            </tr>
            <tr>
                <td colspan="2">
                    <input type="reset" value="초기화">
                    <input type="submit" value="가입">
                </td>
            </tr>
        </table>
    </form>
</body>
</html>